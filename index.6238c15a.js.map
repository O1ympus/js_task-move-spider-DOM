var spider = document.querySelector(".spider");
var wall = document.querySelector(".wall");
wall.addEventListener("click", function(e) {
    var wallCoordinates = wall.getBoundingClientRect();
    if (e.clientX >= wallCoordinates.left && e.clientX <= wallCoordinates.right && e.clientY >= wallCoordinates.top && e.clientY <= wallCoordinates.bottom) {
        var x = e.offsetX - spider.offsetWidth / 2;
        var y = e.offsetY - spider.offsetHeight / 2;
